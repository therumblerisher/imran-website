---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const writing = (await getCollection('writing'))
  .filter((entry) => entry.data.state === 'published')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en', {
    month: 'short',
    year: 'numeric',
  }).format(date);

const elsewhere = [
  {
    label: 'GitHub',
    value: 'therumblerisher',
    href: 'https://github.com/therumblerisher',
  },
  {
    label: 'LinkedIn',
    value: 'imranrazli',
    href: 'https://linkedin.com/in/imranrazli',
  },
  {
    label: 'X',
    value: '@inf42__',
    href: 'https://x.com/inf42__',
  },
  {
    label: 'Email',
    value: 'imranhq957@gmail.com',
    href: 'mailto:imranhq957@gmail.com',
  },
];

type ProjectChild = {
  name: string;
  href?: string;
  description: string;
};

type ProjectStudio = {
  name: string;
  href?: string;
  description: string;
  children: ProjectChild[];
};

const projects: ProjectStudio[] = [
  {
    name: 'Entropic Labs',
    description:
      'My personal studio for full-stack web apps and Malaysian AI products.',
    children: [
      {
        name: 'Kira',
        href: 'https://trykira.xyz',
        description:
          'Multiplayer receipt splitter built on YTL ILMU and Cloudflare Workers. Snap a receipt, share a link, and let friends claim items. Verifies line-item math against the printed total in code and falls back to a larger model on mismatch.',
      },
      {
        name: 'Tender OS',
        href: 'https://github.com/therumblerisher/tender-os',
        description:
          'Open-source hybrid search and grounded Q&A over 6,899 Malaysian public tender notices. Built with FastAPI, PostgreSQL pgvector, and YTL ILMU embeddings with source citations and daily Ringgit spend caps.',
      },
      {
        name: 'DX Gaming Nation',
        href: 'https://dxgamingnation.app',
        description:
          'Booking, QR check-in, session timers, and HitPay payments web app in daily paid use at a gaming venue in Kuala Lumpur.',
      },
      {
        name: 'TaxFind',
        description:
          'AI tax-relief finder for YA2025 that mapped Malaysian bank-statement PDFs into 15 LHDN categories. Backend retired.',
      },
    ],
  },
  {
    name: 'TZ APAC',
    description:
      'Over five years running founder programs, grants, and Fortify Labs, our startup studio, alongside product work at Keystone Lab.',
    children: [
      {
        name: 'Panora',
        description:
          'On-device iOS AI meeting notebook from Keystone Lab. Contributed product design and code across long-meeting note generation, iPhone memory limits, and UI.',
      },
      {
        name: 'Sogni',
        href: 'https://www.sogni.ai',
        description:
          'Decentralized GPU compute network for creative AI and my favorite Fortify Labs portfolio company. Backed their seed round and supported the team through their Kraken listing.',
      },
    ],
  },
];

type UsingItem = {
  name: string;
  href?: string;
  description: string;
};

const usingItems: UsingItem[] = [
  {
    name: 'Omarchy',
    href: 'https://omarchy.org',
    description: 'Arch Linux desktop environment on my main workstation.',
  },
  {
    name: 'Herdr',
    description: 'Desktop workspace for running parallel coding agents across separate project spaces.',
  },
  {
    name: 'Rex',
    description: 'Terminal multiplexer for managing live sessions, panes, and connected tools.',
  },
  {
    name: 'Claude Code',
    description: 'Daily coding agent workflow with isolated git worktrees and cross-model review.',
  },
  {
    name: 'Personal wiki',
    description: 'Local markdown knowledge base maintained with agents for model notes, benchmarks, and tooling research.',
  },
];

type ExploringItem = {
  label: string;
  text: string;
};

const exploringItems: ExploringItem[] = [
  {
    label: 'Local AI',
    text: 'Running Inkling 2 Mini locally on an RTX 5070 12 GB with Strata and llama.cpp, testing decode speed, context limits, and MCP web search.',
  },
  {
    label: 'Model routing',
    text: 'Verifying LLM outputs in code so fast, cheap models stay reliable on Malaysian documents and escalate only on mismatch.',
  },
  {
    label: 'Agent workflows',
    text: 'What small teams can delegate to coding agents with automated tests and visual checks instead of guesswork.',
  },
];
---

<BaseLayout>
  <header class="home-header" id="top">
    <p class="eyebrow">Imran Haqeem</p>
    <h1 class="site-title">Imran Haqeem</h1>
    <p class="lede">Product engineer in Kuala Lumpur building full-stack web apps and Malaysian AI tools.</p>
    <p class="intro">
      I build web apps and AI software under Entropic Labs, my personal studio. At TZ APAC, I have spent over five years running founder programs and Fortify Labs, and contributed product design and code to Panora, an on-device iOS AI meeting app.
    </p>

    <nav class="section-nav" aria-label="Section navigation">
      {writing.length > 0 && (
        <>
          <a href="#writing">Writing</a>
          <span aria-hidden="true">•</span>
        </>
      )}
      <a href="#projects">Projects</a>
      <span aria-hidden="true">•</span>
      <a href="#using">Currently using</a>
      <span aria-hidden="true">•</span>
      <a href="#exploring">Currently exploring</a>
      <span aria-hidden="true">•</span>
      <a href="#elsewhere">Elsewhere</a>
    </nav>
  </header>

  {writing.length > 0 && (
    <section class="section" id="writing" aria-labelledby="writing-title">
      <div class="section-header">
        <h2 class="section-title" id="writing-title">Writing</h2>
        <a class="section-link" href="/writing/">Full archive</a>
      </div>

      <ol class="writing-list">
        {writing.map((entry) => (
          <li class="writing-item">
            <a class="writing-link" href={`/writing/${entry.slug}/`}>
              {entry.data.title}
            </a>
            <span class="writing-meta">{formatDate(entry.data.date)}</span>
          </li>
        ))}
      </ol>
    </section>
  )}

  <section class="section" id="projects" aria-labelledby="projects-title">
    <div class="section-header">
      <h2 class="section-title" id="projects-title">Projects</h2>
      <p class="section-description">Shipped products and studio work.</p>
    </div>

    <ul class="project-list">
      {projects.map((studio) => (
        <li class="project-studio">
          <div class="project-entry">
            {studio.href ? (
              <a class="project-name" href={studio.href} target="_blank" rel="noreferrer">{studio.name}</a>
            ) : (
              <span class="project-name">{studio.name}</span>
            )}
            <p class="project-copy">{studio.description}</p>
          </div>
          <ul class="project-children">
            {studio.children.map((child) => (
              <li class="project-entry">
                {child.href ? (
                  <a class="project-name" href={child.href} target="_blank" rel="noreferrer">{child.name}</a>
                ) : (
                  <span class="project-name">{child.name}</span>
                )}
                <p class="project-copy">{child.description}</p>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ul>
  </section>

  <section class="section" id="using" aria-labelledby="using-title">
    <div class="section-header">
      <h2 class="section-title" id="using-title">Currently using</h2>
      <p class="section-description">Daily tools and workflow.</p>
    </div>

    <ul class="thinking-list">
      {usingItems.map((item) => (
        <li class="thinking-item">
          {item.href ? (
            <a class="project-name" href={item.href} target="_blank" rel="noreferrer">{item.name}</a>
          ) : (
            <span class="elsewhere-label">{item.name}</span>
          )}
          <span>{item.description}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="section" id="exploring" aria-labelledby="exploring-title">
    <div class="section-header">
      <h2 class="section-title" id="exploring-title">Currently exploring</h2>
      <p class="section-description">Active experiments and topics in view.</p>
    </div>

    <ul class="thinking-list">
      {exploringItems.map((item) => (
        <li class="thinking-item">
          <span class="elsewhere-label">{item.label}</span>
          <span>{item.text}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="section" id="elsewhere" aria-labelledby="elsewhere-title">
    <div class="section-header">
      <h2 class="section-title" id="elsewhere-title">Elsewhere</h2>
      <p class="section-description">Where to find me online.</p>
    </div>

    <ul class="elsewhere-list">
      {elsewhere.map((item) => (
        <li class="elsewhere-item">
          <span class="elsewhere-label">{item.label}</span>
          <a class="elsewhere-value" href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel={item.href.startsWith('http') ? 'noreferrer' : undefined}>
            {item.value}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <footer class="footer">
    <p>
      Reach me at <a href="mailto:imranhq957@gmail.com">imranhq957@gmail.com</a>,
      on <a href="https://linkedin.com/in/imranrazli" target="_blank" rel="noreferrer">LinkedIn</a>,
      or on <a href="https://x.com/inf42__" target="_blank" rel="noreferrer">X</a>.
    </p>
  </footer>
</BaseLayout>
